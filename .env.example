# Local development only. Copy to .env and replace the placeholder.
NETSHIELD_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
LIVE_CAPTURE_API_KEY=replace-with-a-long-random-api-key
NETSHIELD_ADMIN_PASSWORD_HASH=
# Optional: email for the bootstrap tenant administrator. Defaults to admin@localhost.
# NETSHIELD_ADMIN_EMAIL=admin@localhost
# Default tenant for legacy/dev data and service-key ingest.
NETSHIELD_DEFAULT_TENANT=default
NETSHIELD_DEFAULT_TENANT_NAME=Default tenant
NETSHIELD_INGEST_TENANT=default
# Trusted reverse-proxy SSO. The proxy must set X-NetShield-User and
# X-NetShield-Proxy-Secret; users must already exist in the users table.
NETSHIELD_TRUSTED_PROXY_SSO=false
NETSHIELD_PROXY_SHARED_SECRET=
MODEL_ARTIFACT_PATH=models/model_bundle.pkl
MODEL_SHA256=
MODEL_REGISTRY_PATH=models/registry/registry.json
# Required only when registry entries are HMAC-signed. Never commit a real key.
MODEL_SIGNING_KEY=
# Production defaults to true; development defaults to false.
REQUIRE_APPROVED_MODEL=
DATABASE_URL=sqlite:///network_anomaly.db
SOCKETIO_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
RATELIMIT_STORAGE_URI=memory://
# Live capture is opt-in and requires Npcap/libpcap plus capture privileges.
# ENABLE_LOCAL_CAPTURE=true
# "auto" follows the OS default route, so Wi-Fi, Ethernet, mobile hotspot /
# USB tethering, and VPN all work without editing this file. Other values:
# "all", "loopback", or a comma-separated list of adapter names/descriptions/IPs.
# Run `python live_capture.py --list` to see this machine's adapters.
# NETSHIELD_CAPTURE_INTERFACE=auto
NETSHIELD_DEMO_STREAM=false
METRICS_ENABLED=false
METRICS_HOST=127.0.0.1
METRICS_PORT=8000
MAX_CONTENT_LENGTH=52428800

# Optional OIDC SSO. Disabled by default; see .env.staging.example. Leave JIT
# provisioning and local-account linking off unless the site accepts the change.
OIDC_ENABLED=false
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=netshield
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:5000/auth/oidc/callback
# OIDC_JIT_PROVISIONING=false
# OIDC_LINK_LOCAL_ACCOUNTS=false

# Optional key for the encrypted backup drill. Key custody is not operated.
# NETSHIELD_BACKUP_KEY=

# Optional external enrichment. Public IPs may be sent to the configured provider.
# ABUSEIPDB_API_KEY=
# NETSHIELD_THREAT_INTEL_ENABLED=false
