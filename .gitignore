# Python & Virtual Environments
venv/
env/
.venv/
__pycache__/
*.py[cod]
*$py.class

# Environment variables & local secrets
.env
.env.local

# IDE & Editor artifacts
.vscode/
.idea/
.hintrc
.netbeans-derby/
.claude/

# Application Runtime & Uploads
uploads/*
!uploads/.gitkeep
instance/
*.db
*.sqlite
*.sqlite3
*.log
# Small deterministic Zeek fixtures required by tests/test_zeek_parser.py
!tests/fixtures/*.log
backups/
docs/backup_restore_artifacts/*.enc

# Raw Data (large CIC-IDS-2017 files >100MB)
data/*.csv
data/*.pcap
# Preserve sample evaluation datasets in git
!data/samples/
!data/samples/*.csv
!data/samples/.gitkeep

# Large ML Model Artifacts (Use Git LFS or GitHub Release Assets)
# models/random_forest.pkl is ~73MB and should not be tracked directly in git history
models/*.pkl
models/*.onnx
# The registry-active serving bundle is small and required for a runnable clone
!models/model_bundle_rf_day_based_seed42.pkl
# Regenerable score caches; rebuild with scripts/build_score_cache.py
models/eval_cache/
!models/README.md

# Reproducible local full-dataset experiment artifacts (large, regenerated by docs)
scratch/cic-temporal-holdout/
scratch/cic-temporal-balanced/
scratch/cic-temporal-logistic/
scratch/cic-binary-attack/

# Local tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Generated backup/restore drill databases (rebuild with the drill command)
docs/backup_restore_artifacts/

# Internal execution notes kept out of the public repo
archive/internal/

# OS Artifacts
Thumbs.db
Desktop.ini
.DS_Store
data/
