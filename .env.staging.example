# NetShield staging environment template.
#
# Copy this file to a secret store, fill every value, and inject it into the
# staging process. Do not commit a filled copy. Staging uses the same
# authentication, cookie, database, migration, and rate-limit requirements as
# production; it is a release rehearsal, not a development mode.

NETSHIELD_ENV=staging
NETSHIELD_VERSION=staging-YYYYMMDD

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-at-least-32-random-characters
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
LIVE_CAPTURE_API_KEY=replace-me-with-at-least-32-random-characters
# Generate with:
#   python -c "from werkzeug.security import generate_password_hash as g;print(g('use-a-password-manager'))"
NETSHIELD_ADMIN_PASSWORD_HASH=replace-me-with-a-werkzeug-password-hash

# PostgreSQL is required. SQLite is rejected by preflight and by app startup.
DATABASE_URL=postgresql://netshield:replace-me@db.internal:5432/netshield
# Shared storage is required; memory:// is rejected.
RATELIMIT_STORAGE_URI=redis://redis.internal:6379/0
SOCKETIO_ALLOWED_ORIGINS=https://netshield-staging.example.com

# Serving artifact. Keep this equal to the registry-approved hash.
MODEL_REGISTRY_PATH=models/registry/registry.json
MODEL_SHA256=fa4c78a38b9ae6e596df37708107a0c1c727b38a774243bbc24318860ae01350
REQUIRE_APPROVED_MODEL=true
MODEL_SIGNING_KEY=
MIGRATIONS_REQUIRED=true

# Release-mode switches.
ENABLE_LOCAL_CAPTURE=false
NETSHIELD_DEMO_STREAM=false
METRICS_ENABLED=true
METRICS_HOST=127.0.0.1
METRICS_PORT=8000

# Encrypted backup. Generate a 32-byte key:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
NETSHIELD_BACKUP_KEY=replace-me-with-base64-32-bytes
NETSHIELD_OFFSITE_BACKUP_DIR=/mnt/offsite/netshield

# OIDC SSO. Leave disabled only if the site explicitly accepts password-only
# sign-in for this rehearsal.
OIDC_ENABLED=true
OIDC_ISSUER=https://idp.example.com
OIDC_CLIENT_ID=netshield-staging
OIDC_CLIENT_SECRET=replace-me-with-the-provider-client-secret
OIDC_REDIRECT_URI=https://netshield-staging.example.com/auth/oidc/callback
OIDC_SCOPES=openid email profile
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_REQUIRE_VERIFIED_EMAIL=true
OIDC_JIT_PROVISIONING=false
OIDC_LINK_LOCAL_ACCOUNTS=false
OIDC_DEFAULT_ROLE=viewer
OIDC_DEFAULT_TENANT=default
